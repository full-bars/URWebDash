# URWebDash container configuration (docker-compose reads this automatically).
# All settings are optional; uncomment what you need.

# Required unless you bind-mount an existing jwt at /host-jwt.
# Get an auth code at https://ur.io, paste it here, and it is exchanged for a
# session token on first start. The token is saved in ./data/jwt, so this can
# be removed afterwards.
#URNETWORK_AUTH_CODE=abcd1234

# Discord webhook for payout + traffic-spike alerts (blank = disabled).
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Unpaid-bytes delta within one polling window that counts as a spike.
# Accepts human sizes: 500MB / 500m / 0.5G / 1.5GB / plain bytes. Default 1GB.
#SPIKE_THRESHOLD=500M

# Polling interval, minimum 1m. Default 15m.
#STATS_INTERVAL=15m

# Dashboard listen address inside the container. Keep 0.0.0.0 here; exposure
# is controlled by the ports: mapping in docker-compose.yml (loopback by default).
#HOST=0.0.0.0
