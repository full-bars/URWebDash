[Unit]
Description=URWebDash polling daemon
Documentation=https://github.com/full-bars/URWebDash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/stats_tracker run
Restart=on-failure
RestartSec=30

# Environment=STATS_INTERVAL=5m
# Environment=DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Environment=STATS_DB=%h/.urnetwork/wallet_stats.db

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
