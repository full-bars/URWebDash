[Unit]
Description=URWebDash polling daemon
Documentation=https://github.com/full-bars/URWebDash
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the installing user; change if you installed elsewhere.
User=YOUR_USER
ExecStart=/home/YOUR_USER/.local/bin/urwebdash run
Restart=on-failure
RestartSec=30

# Environment=STATS_INTERVAL=5m
# Environment=DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Environment=STATS_DB=/home/YOUR_USER/.urnetwork/wallet_stats.db

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
